{
  "extends": "fastify-tsconfig",
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "paths": {
      "#/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}